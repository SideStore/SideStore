          }
        }
      }
    },
    "The Developer disk located at %@ is incompatible with %@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "The Developer disk located at %1$@ is incompatible with %2$@."
          }
