          }
        }
      }
    },
    "Are you sure you want to clear adi.pb from the Keychain? You will need to log back in to Apple ID in SideStore.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키체인에서 adi.pb를 지우시겠습니까? SideStore에서 Apple 계정으로 다시 로그인해야 합니다."
          }
