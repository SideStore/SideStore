          }
        }
      }
    },
    "The app group '%@' does not match the app's bundle ID casing. Would you like to correct it to '%@'?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "The app group '%1$@' does not match the app's bundle ID casing. Would you like to correct it to '%2$@'?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱 그룹 '%1$@'이(가) 앱의 번들 ID 대소문자와 일치하지 않습니다. '%2$@'(으)로 수정하시겠습니까?"
          }
        }
      }
    },
    "The app is in an invalid format.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱 형식이 잘못되었습니다."
          }
        }
      }
    },
    "The app is in an invalid format: %@": {
      "extractionState": "manual",
      "localizations": {
