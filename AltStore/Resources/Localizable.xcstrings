          "stringUnit": {
            "state": "translated",
            "value": "앱 형식이 올바르지 않습니다: %@"
          }
        }
      }
    },
    "The app you are installing has a bundle ID (%@) that does not match the active app (%@). Would you like to proceed?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "The app you are installing has a bundle ID (%1$@) that does not match the active app (%2$@). Would you like to proceed?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설치하려는 앱의 번들 ID(%1$@)가 활성 앱(%2$@)과 일치하지 않습니다. 계속하시겠습니까?"
          }
        }
      }
    },
    "The app's Info.plist could not be found.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
