            "value": "추천 저장소 보기"
          }
        }
      }
    },
    "View, edit, or offline the header properties sent to Apple during provisioning, and control if SideStore automatically rotates/retries servers upon failure.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프로비저닝 중 Apple로 전송되는 헤더 속성을 보고, 편집하고, 오프라인으로 전환할 수 있으며, 실패 시 SideStore가 서버를 자동으로 순환/재시도할지 제어할 수 있습니다."
          }
        }
      }
    },
    "Vision Pro": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Vision Pro"
          }
        }
      }
    },
    "Visualization Mode": {
      "localizations": {
