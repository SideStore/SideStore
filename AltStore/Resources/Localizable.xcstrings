    "SideJITServer": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "SideJITServer"
          }
        }
      }
    },
    "SideJITServer attaches Apple's debugserver service on macOS to running apps on iOS 17+ over local Wi-Fi or USB.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "SideJITServer는 로컬 Wi-Fi 또는 USB를 통해 macOS의 Apple debugserver 서비스를 iOS 17 이상에서 실행 중인 앱에 연결합니다."
          }
        }
      }
    },
    "SideJITServer is unable to connect to your iDevice. Please make sure you have paired your iDevice by running 'SideJITServer -y', or try refreshing SideJITServer from Settings.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "SideJITServer가 iDevice에 연결할 수 없습니다. 'SideJITServer -y'를 실행하여 iDevice를 페어링했는지 확인하거나, 설정에서 SideJITServer를 갱신해 보세요."
          }
        }
      }
    },
    "SideStore": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "SideStore"
          }
        }
      }
    },
    "SideStore Expired": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "SideStore 만료됨"
          }
        }
      }
    },
    "SideStore Expiring Extremely Soon": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "SideStore가 곧 만료됩니다"
          }
        }
      }
    },
    "SideStore Expiring Soon": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "SideStore가 곧 만료됩니다"
          }
        }
      }
    },
    "SideStore News": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "SideStore 소식"
          }
        }
      }
    },
    "SideStore Ready": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "SideStore 준비 완료"
          }
        }
      }
    },
    "SideStore can only install marketplace apps that have been notarized by Apple.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "SideStore는 Apple의 공증을 받은 마켓플레이스 앱만 설치할 수 있습니다."
          }
        }
      }
    },
    "SideStore cannot manage the existing certificate without owning its private key. The apps signed with the existing certificate will expire soon unless they are resigned and renewed explicitly by SideStore.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "SideStore는 개인 키를 소유하지 않은 상태에서는 기존 인증서를 관리할 수 없습니다. 기존 인증서로 서명된 앱은 SideStore가 명시적으로 재서명하고 갱신하지 않으면 곧 만료됩니다."
          }
        }
      }
    },
    "SideStore could not determine this device's UDID. Please replace your pairing using iloader.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "SideStore가 이 기기의 UDID를 확인할 수 없습니다. iloader를 사용하여 페어링을 다시 설정해 주세요."
          }
        }
      }
    },
    "SideStore could not establish a secure connection to %@.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "SideStore가 %@에 대한 보안 연결을 설정할 수 없습니다."
          }
        }
      }
    },
    "SideStore could not find this device.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "SideStore가 이 기기를 찾을 수 없습니다."
          }
        }
      }
    },
    "SideStore could not write data to this device.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "SideStore가 이 기기에 데이터를 쓸 수 없습니다."
          }
        }
      }
    },
    "SideStore does not have detailed information for these entitlements.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "SideStore에 이러한 권한에 대한 세부 정보가 없습니다."
          }
        }
      }
    },
    "SideStore does not support this request.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "SideStore는 이 요청을 지원하지 않습니다."
          }
        }
      }
    },
    "SideStore has expired. Please refresh or reinstall the app.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "SideStore가 만료되었습니다. 앱을 갱신하거나 다시 설치해 주세요."
          }
        }
      }
    },
    "SideStore is unable to reach the device endpoint.\n\nPlease check your Connection Configuration in Settings to ensure the IP and endpoint are correct.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "SideStore가 기기 엔드포인트에 연결할 수 없습니다.\n\n설정의 연결 구성에서 IP와 엔드포인트가 올바른지 확인해 주세요."
          }
        }
      }
    },
    "SideStore is unable to reach the device endpoint:\n%@\n\nPlease check your Connection Configuration in Settings.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "SideStore가 기기 엔드포인트에 연결할 수 없습니다:\n%@\n\n설정의 연결 구성을 확인해 주세요."
          }
        }
      }
    },
    "SideStore needs to deactivate another app before installing %@.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@을(를) 설치하려면 SideStore가 다른 앱을 먼저 비활성화해야 합니다."
          }
        }
      }
    },
    "SideStore received an invalid request.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "SideStore가 잘못된 요청을 받았습니다."
          }
        }
      }
    },
    "SideStore received an invalid response from %@.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "SideStore가 %@로부터 잘못된 응답을 받았습니다."
          }
        }
      }
    },
    "SideStore received an unknown response from SideStore.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "SideStore가 SideStore로부터 알 수 없는 응답을 받았습니다."
          }
        }
      }
    },
    "SideStore sent an invalid response.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "SideStore가 잘못된 응답을 보냈습니다."
          }
        }
      }
    },
    "SideStore was denied permission to launch %@.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "SideStore가 %@을(를) 실행할 권한을 거부당했습니다."
          }
        }
      }
    },
    "SideStore was installed by a different signing tool (like Xcode or AltStore).": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "SideStore가 다른 서명 도구(Xcode 또는 AltStore 등)로 설치되었습니다."
          }
        }
      }
    },
    "SideStore will expire in 24 hours. Open the app and refresh it to prevent it from expiring.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "SideStore가 24시간 후 만료됩니다. 만료를 방지하려면 앱을 열고 갱신해 주세요."
          }
        }
      }
    },
    "SideStore will expire in 6 hours! Refresh now to prevent expiration.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "SideStore가 6시간 후 만료됩니다! 만료를 방지하려면 지금 갱신하세요."
          }
        }
      }
    },
    "SideStore's connection to %@ timed out.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "SideStore의 %@ 연결 시간이 초과되었습니다."
          }
        }
      }
    },
    "SideStore's database could not be saved.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "SideStore의 데이터베이스를 저장할 수 없습니다."
          }
        }
      }
    },
    "SideStore's shared app group could not be accessed.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "SideStore의 공유 앱 그룹에 액세스할 수 없습니다."
