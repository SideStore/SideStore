          }
        }
      }
    },
    "Are you sure you want to delete '%@' (%@) from the Apple Developer Portal?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Are you sure you want to delete '%1$@' (%2$@) from the Apple Developer Portal?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘%1$@’(%2$@)을(를) Apple Developer Portal에서 삭제하시겠습니까?"
          }
        }
      }
    },
    "Are you sure you want to delete '%@' (%@)? This will also remove any associated provisioning profiles.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Are you sure you want to delete '%1$@' (%2$@)? This will also remove any associated provisioning profiles."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘%1$@’(%2$@)을(를) 삭제하시겠습니까? 관련된 모든 프로비저닝 프로파일도 함께 제거됩니다."
          }
        }
      }
    },
    "Are you sure you want to delete '%@' from the Apple Developer Portal?": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘%@’을(를) Apple Developer Portal에서 삭제하시겠습니까?"
          }
        }
      }
    },
    "Are you sure you want to delete the backup for this app? This action cannot be undone.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 앱의 백업을 삭제하시겠습니까? 이 작업은 되돌릴 수 없습니다."
          }
        }
      }
    },
    "Are you sure you want to delete this certificate locally? This will remove it from the cached local store.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 인증서를 로컬에서 삭제하시겠습니까? 로컬 캐시 저장소에서 제거됩니다."
          }
        }
      }
    },
    "Are you sure you want to disable '%@' on the Apple Developer Portal? Disabled devices will not be included in newly generated provisioning profiles.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Developer Portal에서 ‘%@’을(를) 비활성화하시겠습니까? 비활성화된 기기는 새로 생성되는 프로비저닝 프로파일에 포함되지 않습니다."
          }
        }
      }
    },
    "Are you sure you want to permanently delete these %d items?": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 %d개 항목을 영구적으로 삭제하시겠습니까?"
          }
        }
      }
    },
    "Are you sure you want to proceed to delete %d appIds?": {
