    "FeG-e5-LJl.text": {
      "comment": "Class = \"UITextView\"; text = \"Thank you for using SideStore!\\n        \\nSubscribing to the patreon supports us and makes sure we can continue developing SideStore for you.\\n    \\nFollowing us on social media allows us to give quick updates and spread the word about sideloading!\\n        \\n-SideTeam\"; ObjectID = \"FeG-e5-LJl\";",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Thank you for using SideStore!\n        \nSubscribing to the patreon supports us and makes sure we can continue developing SideStore for you.\n    \nFollowing us on social media allows us to give quick updates and spread the word about sideloading!\n        \n-SideTeam"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "SideStore를 사용해 주셔서 감사합니다!\n        \nPatreon을 구독하시면 저희를 후원하고 SideStore를 계속 개발할 수 있도록 도와주시는 것입니다.\n    \n소셜 미디어에서 저희를 팔로우하시면 빠른 업데이트 소식과 사이드로딩 관련 소식을 받아보실 수 있습니다!\n        \n-SideTeam"
          }
        }
      }
    },
    "VdY-7Q-amF.normalTitle": {
