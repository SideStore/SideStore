{
  "sourceLanguage": "en",
  "strings": {
    "%@ %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ %2$@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@"
          }
        }
      }
    },
    "%@ error %@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ error %2$@."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 오류 %2$@."
          }
        }
      }
    },
    "%@ failed with code %@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ failed with code %2$@."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@이(가) 코드 %2$@(으)로 실패했습니다."
          }
        }
      }
    },
    "%@ failed.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@이(가) 실패했습니다."
          }
        }
      }
    },
    "%@ is currently locked.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@이(가) 현재 잠겨 있습니다."
          }
        }
      }
    },
    "%@ is not currently running on %@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ is not currently running on %2$@."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@이(가) 현재 %2$@에서 실행 중이 아닙니다."
          }
        }
      }
    },
    "%@ received an invalid request from SideStore.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@이(가) SideStore로부터 잘못된 요청을 받았습니다."
          }
        }
      }
    },
    "%@ requires %@ or later.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ requires %2$@ or later."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@에는 %2$@ 이상이 필요합니다."
          }
        }
      }
    },
    "%@ returned unexpected output.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@이(가) 예기치 않은 출력을 반환했습니다."
          }
        }
      }
    },
    "%@ timed out.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 시간이 초과되었습니다."
          }
        }
      }
    },
    "%@ unexpectedly quit.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@이(가) 예기치 않게 종료되었습니다."
          }
        }
      }
    },
    "%d": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%d"
          }
        }
      }
    },
