    "The process '%@'": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프로세스 '%@'"
          }
        }
      }
    },
    "The provided anisette data is invalid.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제공된 Anisette 데이터가 유효하지 않습니다."
