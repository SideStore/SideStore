        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "7+"
          }
        }
      }
    },
    "AltServer could not connect to Mail plug-in.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AltServer가 Mail 플러그인에 연결할 수 없습니다."
          }
        }
      }
    },
    "AltServer could not establish a connection to SideStore.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AltServer가 SideStore에 연결을 설정할 수 없습니다."
          }
        }
      }
    },
    "An error occured while removing the app.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱을 제거하는 동안 오류가 발생했습니다."
          }
        }
      }
    },
    "An error occurred while installing the app.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱을 설치하는 동안 오류가 발생했습니다."
          }
        }
      }
    },
    "An unknown error occured.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알 수 없는 오류가 발생했습니다."
          }
        }
      }
    },
    "Connection error code: %@": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결 오류 코드: %@"
          }
        }
      }
    },
    "Could not connect to SideStore.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "SideStore에 연결할 수 없습니다."
          }
        }
      }
    },
    "Could not find profile": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프로파일을 찾을 수 없음"
          }
        }
      }
    },
