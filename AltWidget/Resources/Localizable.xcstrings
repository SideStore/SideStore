        }
      }
    },
    "The requested app": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "요청한 앱"
          }
        }
      }
    },
    "There was an error connecting to the device.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기에 연결하는 중 오류가 발생했습니다."
          }
        }
      }
    },
    "There was an issue communicating with the usbmuxd daemon.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "usbmuxd 데몬과 통신하는 중 문제가 발생했습니다."
          }
        }
      }
    },
    "Title": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제목"
          }
        }
      }
    },
    "Underlying Error": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "근본 오류"
          }
        }
      }
    },
    "Underlying Errors": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "근본 오류"
          }
        }
      }
    },
    "Unsupported iOS": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지원되지 않는 iOS"
          }
        }
      }
    },
    "Version %@%@": {
      "comment": "SideStore Version",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Version %1$@%2$@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "버전 %1$@%2$@"
          }
        }
      }
    },
    "You cannot activate more than 3 apps with a non-developer Apple ID.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비개발자 Apple 계정으로는 앱을 3개 초과하여 활성화할 수 없습니다."
          }
        }
      }
    },
    "Your device must be running iOS 15.0 or later to install SideStore.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "SideStore를 설치하려면 기기가 iOS 15.0 이상을 실행 중이어야 합니다."
          }
        }
      }
    },
    "day": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일 후 만료"
          }
        }
      }
    },
    "days": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일 후 만료"
          }
