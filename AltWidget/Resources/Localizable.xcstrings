        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@에 있는 개발자 디스크가 %2$@와(과) 호환되지 않습니다."
          }
        }
      }
    },
    "The app is in an invalid format.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱 형식이 잘못되었습니다."
          }
        }
      }
    },
