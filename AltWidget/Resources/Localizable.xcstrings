      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기"
          }
        }
      }
    },
    "The disk is incompatible with %@.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "디스크가 %@와(과) 호환되지 않습니다."
