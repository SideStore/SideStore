      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일"
          }
        }
      }
    },
    "Debug Description": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "디버그 설명"
          }
        }
      }
    },
    "Error Description": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오류 설명"
          }
        }
      }
    },
    "Error code: %@": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오류 코드: %@"
          }
        }
      }
    },
    "Expired": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "만료됨"
          }
        }
      }
    },
    "Expires in\n": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "만료까지\n"
          }
        }
      }
    },
    "Expires in %d ": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%d"
          }
        }
      }
    },
    "Failure": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실패"
          }
        }
      }
    },
    "Failure Reason": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실패 이유"
          }
        }
      }
    },
    "Launch app to update widget": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위젯을 업데이트하려면 앱을 실행하세요"
          }
        }
      }
    },
    "Lost connection to SideStore.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "SideStore와의 연결이 끊어졌습니다."
          }
        }
      }
    },
    "Mail has been automatically opened, try again in a moment. Otherwise, make sure plug-in is enabled in Mail's preferences.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메일이 자동으로 열렸습니다. 잠시 후 다시 시도해 주세요. 그래도 안 되면 메일 환경설정에서 플러그인이 활성화되어 있는지 확인하세요."
          }
        }
      }
    },
    "Make sure the app is running in the foreground on %@ then try again.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에서 앱이 포그라운드에서 실행 중인지 확인한 다음 다시 시도하세요."
          }
        }
      }
    },
    "Make sure you have trusted this device with your computer and Wi-Fi sync is enabled.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기가 컴퓨터에서 신뢰할 수 있는 기기로 설정되어 있고 Wi-Fi 동기화가 활성화되어 있는지 확인하세요."
          }
        }
      }
    },
    "Open SideStore": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "SideStore 열기"
          }
        }
      }
    },
    "Please deactivate a sideloaded app in order to install another one.\n\nIf you're running iOS 13.5 or later, make sure “Offload Unused Apps” is disabled in Settings > iTunes & App Stores, then install or delete all offloaded apps.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 앱을 설치하려면 사이드로드된 앱을 비활성화하세요.\n\niOS 13.5 이상을 사용 중이라면 설정 > iTunes 및 App Store에서 “사용하지 않는 앱 정리”가 꺼져 있는지 확인한 다음, 오프로드된 모든 앱을 설치하거나 삭제하세요."
          }
        }
      }
    },
    "Please deactivate a sideloaded app with SideStore in order to install another app.\n\nIf you're running iOS 13.5 or later, make sure 'Offload Unused Apps' is disabled in Settings > iTunes & App Stores, then install or delete all offloaded apps to prevent them from erroneously counting towards this limit.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 앱을 설치하려면 SideStore로 사이드로드된 앱을 비활성화하세요.\n\niOS 13.5 이상을 사용 중이라면 설정 > iTunes 및 App Store에서 'Offload Unused Apps'가 꺼져 있는지 확인한 다음, 오프로드된 모든 앱을 설치하거나 삭제하여 이 제한에 잘못 포함되지 않도록 하세요."
          }
        }
      }
    },
    "Please unlock the device with your passcode and try again.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "암호로 기기 잠금을 해제한 다음 다시 시도해 주세요."
          }
        }
      }
    },
    "Recovery Suggestion": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복구 제안"
          }
        }
      }
    },
    "Requires %@ or later": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 이상 필요"
          }
        }
      }
    },
    "SideStore could not establish a secure connection to %@.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "SideStore가 %@에 대한 보안 연결을 설정할 수 없습니다."
          }
        }
      }
    },
    "SideStore could not find this device.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "SideStore가 이 기기를 찾을 수 없습니다."
          }
        }
      }
    },
    "SideStore could not write data to this device.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "SideStore가 이 기기에 데이터를 쓸 수 없습니다."
          }
        }
      }
    },
    "SideStore does not support this request.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "SideStore는 이 요청을 지원하지 않습니다."
          }
        }
      }
    },
    "SideStore received an invalid request.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "SideStore가 잘못된 요청을 받았습니다."
          }
        }
      }
    },
    "SideStore received an invalid response from %@.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "SideStore가 %@로부터 잘못된 응답을 받았습니다."
          }
        }
      }
    },
    "SideStore received an unknown response from SideStore.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "SideStore가 SideStore로부터 알 수 없는 응답을 받았습니다."
          }
        }
      }
    },
    "SideStore sent an invalid response.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "SideStore가 잘못된 응답을 보냈습니다."
          }
        }
      }
    },
    "SideStore's connection to %@ timed out.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "SideStore의 %@ 연결 시간이 초과되었습니다."
          }
        }
      }
    },
    "Source File": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "소스 파일"
